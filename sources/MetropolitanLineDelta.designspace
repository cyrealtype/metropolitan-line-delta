<?xml version='1.0' encoding='UTF-8'?>
<designspace format="5.1">
  <axes>
    <axis tag="wght" name="Weight" minimum="400" maximum="900" default="400">
      <labelname xml:lang="en">Weight</labelname>
    </axis>
  </axes>

  <sources>

    <source filename="MetropolitanLineDelta-Regular.ufo"
            name="Metropolitan Line Delta Regular"
            familyname="Metropolitan Line" stylename="Regular">
      <lib copy="1"/>
      <groups copy="1"/>
      <features copy="1"/>
      <info copy="1"/>
      <location>
        <dimension name="Weight" xvalue="400"/>
      </location>
    </source>
  </sources>

    

  <variable-fonts>
    <variable-font name="MetropolitanLineDelta-VF">
      <axis-subsets>
        <axis-subset name="Weight"/>
      </axis-subsets>
    </variable-font>
  </variable-fonts>
</designspace>