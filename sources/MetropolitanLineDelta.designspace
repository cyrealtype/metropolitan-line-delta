<?xml version='1.0' encoding='UTF-8'?>
<designspace format="5.1">
  <axes>
    <axis tag="wght" name="Weight" minimum="1" maximum="1000" default="400"/>
    <axis tag="XTSP" name="XTSP" minimum="5" maximum="140" default="72.5"/>
    <axis tag="XOPQ" name="XOPQ" minimum="5" maximum="300" default="110" hidden="1"/>
    <axis tag="YOPQ" name="YOPQ" minimum="5" maximum="280" default="100" hidden="1"/>
    <axis tag="XOUC" name="XOUC" minimum="5" maximum="300" default="110" hidden="1"/>
    <axis tag="XOLC" name="XOLC" minimum="5" maximum="300" default="110" hidden="1"/>
    <axis tag="YOUC" name="YOUC" minimum="5" maximum="280" default="100" hidden="1"/>
    <axis tag="YOLC" name="YOLC" minimum="5" maximum="280" default="100" hidden="1"/>
    <axis tag="STUI" name="STUI" minimum="2" maximum="700" default="92" hidden="1"/>
    <axis tag="STUO" name="STUO" minimum="2" maximum="700" default="92" hidden="1"/>
    <axis tag="XTRA" name="XTRA" minimum="30" maximum="617" default="357">
      <labelname xml:lang="en">X Transparency</labelname>
    </axis>
    <axis tag="XTUC" name="XTUC" minimum="10" maximum="617" default="357">
      <labelname xml:lang="en">X Transparency Uppercase</labelname>
    </axis>
    <axis tag="XTLC" name="XTLC" minimum="10" maximum="617" default="357">
      <labelname xml:lang="en">X Transparency Lowercase</labelname>
    </axis>
    <mappings description="Horizontal stroke">
      <mapping description="min">
        <input>
          <dimension name="XOPQ" xvalue="5"/>
        </input>
        <output>
          <dimension name="XOUC" xvalue="5"/>
          <dimension name="XOLC" xvalue="5"/>
        </output>
      </mapping>
      <mapping description="max">
        <input>
          <dimension name="XOPQ" xvalue="300"/>
        </input>
        <output>
          <dimension name="XOUC" xvalue="300"/>
          <dimension name="XOLC" xvalue="300"/>
        </output>
      </mapping>
    </mappings>
    <mappings description="Vertical stroke">
      <mapping description="min">
        <input>
          <dimension name="YOPQ" xvalue="5"/>
        </input>
        <output>
          <dimension name="YOUC" xvalue="5"/>
          <dimension name="YOLC" xvalue="5"/>
        </output>
      </mapping>
      <mapping description="max">
        <input>
          <dimension name="YOPQ" xvalue="280"/>
        </input>
        <output>
          <dimension name="YOUC" xvalue="280"/>
          <dimension name="YOLC" xvalue="280"/>
        </output>
      </mapping>
    </mappings>
    <mappings description="Weight">
      <mapping description="Light">
        <input>
          <dimension name="Weight" xvalue="1"/>
        </input>
        <output>
          <dimension name="XOPQ" xvalue="5"/>
          <dimension name="YOPQ" xvalue="5"/>
          <dimension name="XTSP" xvalue="72.5"/>
          <dimension name="XOUC" xvalue="5"/>
          <dimension name="XOLC" xvalue="5"/>
          <dimension name="YOUC" xvalue="5"/>
          <dimension name="YOLC" xvalue="5"/>
          <dimension name="XTRA" xvalue="357"/>
          <dimension name="XTUC" xvalue="357"/>
          <dimension name="XTLC" xvalue="357"/>
        </output>
      </mapping>
      <mapping description="Regular">
        <input>
          <dimension name="Weight" xvalue="400"/>
        </input>
        <output>
          <dimension name="XOUC" xvalue="110"/>
          <dimension name="XOLC" xvalue="110"/>
          <dimension name="YOUC" xvalue="100"/>
          <dimension name="XOPQ" xvalue="110"/>
          <dimension name="YOPQ" xvalue="100"/>
          <dimension name="XTSP" xvalue="72.5"/>
          <dimension name="YOLC" xvalue="100"/>
          <dimension name="STUI" xvalue="92"/>
          <dimension name="STUO" xvalue="92"/>
          <dimension name="XTRA" xvalue="357"/>
          <dimension name="XTUC" xvalue="357"/>
          <dimension name="XTLC" xvalue="357"/>
        </output>
      </mapping>
      <mapping description="Black">
        <input>
          <dimension name="Weight" xvalue="1000"/>
        </input>
        <output>
          <dimension name="YOPQ" xvalue="188"/>
          <dimension name="XTSP" xvalue="50"/>
          <dimension name="XOPQ" xvalue="230"/>
          <dimension name="XOUC" xvalue="230"/>
          <dimension name="XOLC" xvalue="230"/>
          <dimension name="YOUC" xvalue="220"/>
          <dimension name="YOLC" xvalue="220"/>
          <dimension name="STUI" xvalue="92"/>
          <dimension name="STUO" xvalue="92"/>
          <dimension name="XTRA" xvalue="357"/>
          <dimension name="XTUC" xvalue="357"/>
          <dimension name="XTLC" xvalue="357"/>
        </output>
      </mapping>
    </mappings>
  </axes>
