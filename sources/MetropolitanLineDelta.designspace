<?xml version='1.0' encoding='UTF-8'?>
<designspace format="5.1">
  <axes>
    <axis tag="wght" name="Weight" minimum="1" maximum="1000" default="400"/>
    <axis tag="XTSP" name="XTSP" minimum="5" maximum="140" default="0"/>
    <axis tag="XOPQ" name="XOPQ" minimum="2" maximum="300" default="110" hidden="1"/>
    <axis tag="YOPQ" name="YOPQ" minimum="2" maximum="280" default="100" hidden="1"/>
    <axis tag="XOUC" name="XOUC" minimum="2" maximum="300" default="110" hidden="1"/>
    <axis tag="YOUC" name="YOUC" minimum="2" maximum="280" default="100" hidden="1"/>
    <mappings description="Horizontal stroke">
      <mapping description="min">
        <input>
          <dimension name="XOPQ" xvalue="2"/>
        </input>
        <output>
          <dimension name="XOUC" xvalue="2"/>
        </output>
      </mapping>
      <mapping description="max">
        <input>
          <dimension name="XOPQ" xvalue="300"/>
        </input>
        <output>
          <dimension name="XOUC" xvalue="110"/>
        </output>
      </mapping>
    </mappings>
    <mappings description="Vertical stroke">
      <mapping description="min">
        <input>
          <dimension name="YOPQ" xvalue="2"/>
        </input>
        <output>
          <dimension name="YOUC" xvalue="2"/>
        </output>
      </mapping>
      <mapping description="max">
        <input>
          <dimension name="YOPQ" xvalue="280"/>
        </input>
        <output>
          <dimension name="YOUC" xvalue="280"/>
        </output>
      </mapping>
    </mappings>
    <mappings description="Weight">
      <mapping description="min">
        <input>
          <dimension name="Weight" xvalue="1"/>
          <dimension name="XTSP" xvalue="-30.826314"/>
        </input>
        <output>
          <dimension name="XOPQ" xvalue="2"/>
          <dimension name="YOPQ" xvalue="2"/>
          <dimension name="XTSP" xvalue="0"/>
          <dimension name="XOUC" xvalue="2"/>
          <dimension name="YOUC" xvalue="2"/>
        </output>
      </mapping>
      <mapping description="default">
        <input>
          <dimension name="Weight" xvalue="400"/>
        </input>
        <output>
          <dimension name="XTSP" xvalue="0"/>
          <dimension name="XOPQ" xvalue="110"/>
          <dimension name="YOPQ" xvalue="100"/>
          <dimension name="XOUC" xvalue="110"/>
          <dimension name="YOUC" xvalue="100"/>
        </output>
      </mapping>
      <mapping description="max">
        <input>
          <dimension name="Weight" xvalue="1000"/>
        </input>
        <output>
          <dimension name="XTSP" xvalue="14.861613"/>
          <dimension name="XOPQ" xvalue="300"/>
          <dimension name="YOPQ" xvalue="280"/>
          <dimension name="XOUC" xvalue="300"/>
          <dimension name="YOUC" xvalue="244.455475"/>
        </output>
      </mapping>
    </mappings>
  </axes>
  <sources>
