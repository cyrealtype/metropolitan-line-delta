<?xml version='1.0' encoding='UTF-8'?>
<designspace format="5.1">
  <axes>
    <axis tag="wght" name="Weight" minimum="400" maximum="1000" default="400">
      <labelname xml:lang="en">Weight</labelname>
    </axis>
    <!-- PARAMETRIC -->
    <axis tag="XTSP" name="XTSP" minimum="-100" maximum="100" default="0">
      <labelname xml:lang="en">Parametric Spacing</labelname>
    </axis>
    <axis tag="XOPQ" name="XOPQ" minimum="2" maximum="300" default="110" hidden="1">
      <labelname xml:lang="en">Parametric Thick Stroke</labelname>
    </axis>
    <axis tag="YOPQ" name="YOPQ" minimum="2" maximum="280" default="100" hidden="1">
      <labelname xml:lang="en">Parametric Thin Stroke</labelname>
    </axis>
    <!-- UPPERCASE -->
    <axis tag="XOUC" name="XOUC" minimum="2" maximum="300" default="110" hidden="1">
      <labelname xml:lang="en">Parametric Thick Stroke Uppercase</labelname>
    </axis>
    <axis tag="YOUC" name="YOUC" minimum="2" maximum="280" default="100" hidden="1">
      <labelname xml:lang="en">Parametric Thin Stroke Uppercase</labelname>
    </axis>
  </axes>

  <mappings>
    <!-- Weight 400 (Regular) - Default -->
    <mapping>
      <input>
        <dimension name="Weight" xvalue="400"/>
      </input>
      <output>
        <dimension name="XOPQ" xvalue="110"/>
        <dimension name="YOPQ" xvalue="100"/>
        <dimension name="XOUC" xvalue="110"/>
        <dimension name="YOUC" xvalue="100"/>
        <dimension name="XTSP" xvalue="0"/>
      </output>
    </mapping>

    <!-- Weight 600 (Semibold) -->
    <mapping>
      <input>
        <dimension name="Weight" xvalue="600"/>
      </input>
      <output>
        <dimension name="XOPQ" xvalue="180"/>
        <dimension name="YOPQ" xvalue="150"/>
        <dimension name="XOUC" xvalue="180"/>
        <dimension name="YOUC" xvalue="150"/>
        <dimension name="XTSP" xvalue="-10"/>
      </output>
    </mapping>

    <!-- Weight 800 (Black) -->
    <mapping>
      <input>
        <dimension name="Weight" xvalue="800"/>
      </input>
      <output>
        <dimension name="XOPQ" xvalue="260"/>
        <dimension name="YOPQ" xvalue="210"/>
        <dimension name="XOUC" xvalue="260"/>
        <dimension name="YOUC" xvalue="210"/>
        <dimension name="XTSP" xvalue="-30"/>
      </output>
    </mapping>
  </mappings>

  <sources>
    <source filename="MetropolitanLineDelta-wght400.ufo" name="Regular" familyname="Metropolitan Line Delta" stylename="Regular">
      <location>
        <dimension name="Weight" xvalue="400"/>
        <dimension name="XTSP" xvalue="0"/>
        <dimension name="XOPQ" xvalue="110"/>
        <dimension name="YOPQ" xvalue="100"/>
        <dimension name="XOUC" xvalue="110"/>
        <dimension name="YOUC" xvalue="100"/>
      </location>
    </source>
    <source filename="MetropolitanLineDelta_XTSP-100.ufo" name="XTSP-100" familyname="Metropolitan Line Delta" stylename="XTSP-100">
      <location>
        <dimension name="Weight" xvalue="400"/>
        <dimension name="XTSP" xvalue="-100"/>
        <dimension name="XOPQ" xvalue="110"/>
        <dimension name="YOPQ" xvalue="100"/>
        <dimension name="XOUC" xvalue="110"/>
        <dimension name="YOUC" xvalue="100"/>
      </location>
    </source>
    <source filename="MetropolitanLineDelta_XTSP100.ufo" name="XTSP100" familyname="Metropolitan Line Delta" stylename="XTSP100">
      <location>
        <dimension name="Weight" xvalue="400"/>
        <dimension name="XTSP" xvalue="100"/>
        <dimension name="XOPQ" xvalue="110"/>
        <dimension name="YOPQ" xvalue="100"/>
        <dimension name="XOUC" xvalue="110"/>
        <dimension name="YOUC" xvalue="100"/>
      </location>
    </source>
    <source filename="MetropolitanLineDelta_XOUC2.ufo" name="XOUC2" familyname="Metropolitan Line Delta" stylename="XOUC2">
      <location>
        <dimension name="Weight" xvalue="400"/>
        <dimension name="XTSP" xvalue="0"/>
        <dimension name="XOPQ" xvalue="110"/>
        <dimension name="YOPQ" xvalue="100"/>
        <dimension name="XOUC" xvalue="2"/>
        <dimension name="YOUC" xvalue="100"/>
      </location>
    </source>
    <source filename="MetropolitanLineDelta_XOUC300.ufo" name="XOUC300" familyname="Metropolitan Line Delta" stylename="XOUC300">
      <location>
        <dimension name="Weight" xvalue="400"/>
        <dimension name="XTSP" xvalue="0"/>
        <dimension name="XOPQ" xvalue="110"/>
        <dimension name="YOPQ" xvalue="100"/>
        <dimension name="XOUC" xvalue="300"/>
        <dimension name="YOUC" xvalue="100"/>
      </location>
    </source>
    <source filename="MetropolitanLineDelta_YOUC2.ufo" name="YOUC2" familyname="Metropolitan Line Delta" stylename="YOUC2">
      <location>
        <dimension name="Weight" xvalue="400"/>
        <dimension name="XTSP" xvalue="0"/>
        <dimension name="XOPQ" xvalue="110"/>
        <dimension name="YOPQ" xvalue="100"/>
        <dimension name="XOUC" xvalue="110"/>
        <dimension name="YOUC" xvalue="2"/>
      </location>
    </source>
    <source filename="MetropolitanLineDelta_YOUC280.ufo" name="YOUC280" familyname="Metropolitan Line Delta" stylename="YOUC280">
      <location>
        <dimension name="Weight" xvalue="400"/>
        <dimension name="XTSP" xvalue="0"/>
        <dimension name="XOPQ" xvalue="110"/>
        <dimension name="YOPQ" xvalue="100"/>
        <dimension name="XOUC" xvalue="110"/>
        <dimension name="YOUC" xvalue="280"/>
      </location>
    </source>
  </sources>

  <variable-fonts>
    <variable-font name="MetropolitanLineDelta-VF">
      <axis-subsets>
        <axis-subset name="Weight"/>
        <axis-subset name="XTSP"/>
        <axis-subset name="XOPQ"/>
        <axis-subset name="YOPQ"/>
        <axis-subset name="XOUC"/>
        <axis-subset name="YOUC"/>
      </axis-subsets>
    </variable-font>
  </variable-fonts>
</designspace>